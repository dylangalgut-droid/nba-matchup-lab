# Railway environment variables; configure these in the Railway Variables tab.
# Do not commit any real token or database password.
# Add this variable by referencing the Postgres service's DATABASE_URL in Railway.
DATABASE_URL=<reference to Railway Postgres DATABASE_URL>
# Required in public hosting. Generate a random 32+ byte secret and keep it private.
ADMIN_TOKEN=<random secret at least 24 characters>
AUTO_REFRESH_HOURS=12
REFRESH_ON_START=1
# PORT is supplied by Railway. Do not define it unless you need a local override.
